<?xml version='1.0' encoding='utf-8'?>
<model>
  <materials>
    <material id="1" name="core" depletable="true">
      <density value="18.0" units="g/cm3"/>
      <nuclide name="U235" ao="0.9"/>
      <nuclide name="U238" ao="0.1"/>
    </material>
  </materials>
  <geometry>
    <cell id="1" material="1" region="-1" universe="1"/>
    <surface id="1" type="sphere" boundary="vacuum" coeffs="0.0 0.0 0.0 9.0"/>
  </geometry>
  <settings>
    <run_mode>eigenvalue</run_mode>
    <particles>1000</particles>
    <batches>20</batches>
    <inactive>5</inactive>
    <source type="independent" strength="1.0" particle="neutron">
      <space type="box">
        <parameters>-9.0 -9.0 -9.0 9.0 9.0 9.0</parameters>
      </space>
      <constraints>
        <fissionable>true</fissionable>
      </constraints>
    </source>
    <ifp_n_generation>5</ifp_n_generation>
  </settings>
  <tallies>
    <filter id="1" type="sensitivity">
      <nuclides>U235 U238</nuclides>
      <reactions>elastic inelastic capture fission nu-prompt nu-delayed chi-prompt chi-delayed</reactions>
      <energies>1e-05 100000.0 1000000.0 20000000.0</energies>
    </filter>
    <filter id="2" type="energyout">
      <bins>1e-05 100000.0 1000000.0 20000000.0</bins>
    </filter>
    <tally id="1" name="k-eff sensitivity numerator">
      <filters>1</filters>
      <scores>keff-sensitivity-numerator</scores>
    </tally>
    <tally id="2" name="IFP denominator">
      <scores>ifp-denominator</scores>
    </tally>
    <tally id="3" name="k-eff sensitivity spectrum">
      <filters>2</filters>
      <nuclides>U235 U238</nuclides>
      <scores>prompt-nu-fission delayed-nu-fission</scores>
    </tally>
  </tallies>
</model>
